# My Dental Platform environment variables
#
# Copy this file to .env.local for local development.
# Do not commit real secrets.

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI Realtime website voice receptionist
OPENAI_API_KEY=
# Generate independently, for example: openssl rand -base64 48
OPENAI_VOICE_SIGNING_SECRET=
# Optional model overrides
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Deprecated legacy plan IDs - do not use for new subscriptions.
# Keep empty unless you need to inspect an old deployment.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=

# Hosted subscription plans.
# Create fresh Razorpay plans for the current prices and set these exact IDs.
RAZORPAY_PLAN_STARTER_MONTHLY=plan_ShGxRJzXZynEts
RAZORPAY_PLAN_STARTER_YEARLY=
RAZORPAY_PLAN_PRO_MONTHLY=plan_ShGumDVvGT5kJz
RAZORPAY_PLAN_PRO_YEARLY=

# Manual backup payment link
PUBLIC_RAZORPAY_ME_URL=https://razorpay.me/@mydentalplatform

# Vercel API
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# App
APP_BASE_URL=https://www.mydentalplatform.com
CRON_SECRET=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=

# Transactional email (booking alerts, patient receipts, trial emails)
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# Browser error monitoring (public DSN; strongly recommended for production)
SENTRY_DSN=

# Optional integrations
GOOGLE_MAPS_API_KEY=
