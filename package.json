{
  "name": "mydentalplatform",
  "version": "0.0.0",
  "scripts": {
    "prestart": "node scripts/sync-public-env.mjs development",
    "prebuild": "node scripts/sync-public-env.mjs production",
    "prewatch": "node scripts/sync-public-env.mjs development",
    "pretest": "node scripts/sync-public-env.mjs development",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:seo": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/seo/seo-routing.test.mjs",
    "test:voice": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/voice/voice-session-auth.test.mjs tests/voice/voice-behavior.test.mjs",
    "test:leads": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/leads/lead-ai-call-policy.test.mjs",
    "lint": "eslint src api --max-warnings 0",
    "release:check": "node scripts/release-check.mjs",
    "migrate:clinic-private-data": "node scripts/migrate-clinic-private-data.mjs"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.20",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.20",
    "@sentry/angular": "^10.50.0",
    "@types/nodemailer": "^8.0.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.7.0",
    "nodemailer": "^9.0.6",
    "razorpay": "^2.9.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.23",
    "@angular-eslint/builder": "^19.8.1",
    "@angular-eslint/eslint-plugin": "^19.8.1",
    "@angular-eslint/eslint-plugin-template": "^19.8.1",
    "@angular-eslint/schematics": "^19.8.1",
    "@angular-eslint/template-parser": "^19.8.1",
    "@angular/cli": "^19.2.23",
    "@angular/compiler-cli": "^19.2.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vercel/node": "^5.7.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.68.0"
  }
}
