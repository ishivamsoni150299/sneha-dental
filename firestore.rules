rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function hasVerifiedEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isPhonePatient() {
      return request.auth != null &&
        request.auth.token.phone_number is string &&
        request.auth.token.phone_number.matches('^\\+91[6-9][0-9]{9}$') &&
        request.auth.token.firebase.sign_in_provider == 'phone';
    }

    function isSuperAdmin() {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    function hasClinicAdminClaim(clinicId) {
      return hasVerifiedEmail() &&
        request.auth.token.role == 'admin' &&
        request.auth.token.clinicId == clinicId;
    }

    function validMarketplaceStatus(status) {
      return status in ['unlisted', 'pending', 'verified', 'suspended'];
    }

    // True when the authenticated user is the admin of a specific clinic doc.
    function isClinicAdmin(clinicId) {
      return hasVerifiedEmail() &&
        (
          hasClinicAdminClaim(clinicId) ||
          request.auth.uid == get(/databases/$(database)/documents/clinics/$(clinicId)).data.adminUid ||
          request.auth.uid == get(/databases/$(database)/documents/clinics/$(clinicId)/private/account).data.adminUid
        );
    }

    // True when the authenticated user owns the clinic that this appointment belongs to.
    function ownsAppointmentClinic() {
      return isClinicAdmin(resource.data.clinicId);
    }

    function clinicIsActive(clinicId) {
      return exists(/databases/$(database)/documents/clinics/$(clinicId)) &&
        get(/databases/$(database)/documents/clinics/$(clinicId)).data.active == true;
    }

    function clinicAcceptsMarketplaceAppointments(clinicId) {
      let clinic = get(/databases/$(database)/documents/clinics/$(clinicId));
      return clinic.data.active == true &&
        clinic.data.marketplaceStatus == 'verified' &&
        clinic.data.marketplaceProfile is map &&
        clinic.data.marketplaceProfile.acceptingNewPatients == true;
    }

    function clinicAdminAllowedClinicFields() {
      return [
        'name',
        'doctorName',
        'doctorQualification',
        'patientCount',
        'doctorBio',
        'phone',
        'phoneE164',
        'whatsappNumber',
        'addressLine1',
        'addressLine2',
        'city',
        'mapEmbedUrl',
        'mapDirectionsUrl',
        'hours',
        'services',
        'testimonials',
        'social',
        'theme',
        'logoDataUrl',
        'marketplaceProfile',
        'onboardingDismissed',
        'onboardingSharedWebsite'
      ];
    }

    function validMarketplaceProfile(profile) {
      return profile is map &&
        profile.keys().hasOnly([
          'region', 'locality', 'latitude', 'longitude', 'serviceIds',
          'languages', 'consultationFee', 'paymentMethods',
          'acceptingNewPatients', 'listingImageUrl'
        ]) &&
        profile.keys().hasAll([
          'region', 'locality', 'serviceIds', 'languages',
          'paymentMethods', 'acceptingNewPatients'
        ]) &&
        profile.region == 'delhi-ncr' &&
        profile.locality is string &&
        profile.locality.size() >= 2 &&
        profile.locality.size() <= 120 &&
        (!profile.keys().hasAny(['latitude']) || profile.latitude == null ||
          (profile.latitude is number && profile.latitude >= -90 && profile.latitude <= 90)) &&
        (!profile.keys().hasAny(['longitude']) || profile.longitude == null ||
          (profile.longitude is number && profile.longitude >= -180 && profile.longitude <= 180)) &&
        profile.serviceIds is list &&
        profile.serviceIds.size() >= 1 &&
        profile.serviceIds.size() <= 16 &&
        profile.serviceIds.hasOnly([
          'dental-consultation', 'cleaning-scaling', 'tooth-fillings',
          'root-canal', 'tooth-extraction', 'wisdom-tooth',
          'dental-implants', 'crowns-bridges', 'dentures',
          'braces-orthodontics', 'clear-aligners', 'pediatric-dentistry',
          'gum-treatment', 'teeth-whitening', 'veneers-smile-design',
          'emergency-dental-care'
        ]) &&
        profile.languages is list &&
        profile.languages.size() <= 8 &&
        (!profile.keys().hasAny(['consultationFee']) || profile.consultationFee == null ||
          (profile.consultationFee is number &&
            profile.consultationFee >= 0 && profile.consultationFee <= 100000)) &&
        profile.paymentMethods is list &&
        profile.paymentMethods.hasOnly(['cash', 'upi', 'card', 'insurance']) &&
        profile.acceptingNewPatients is bool &&
        (!profile.keys().hasAny(['listingImageUrl']) || profile.listingImageUrl == null ||
          (profile.listingImageUrl is string && profile.listingImageUrl.size() <= 2000));
    }

    function clinicAdminCanManageBranding() {
      return resource.data.subscriptionStatus == 'active' &&
        resource.data.subscriptionPlan in ['starter', 'pro'];
    }

    function clinicHasActiveOperationsPlan(clinicId) {
      let clinic = get(/databases/$(database)/documents/clinics/$(clinicId));
      return clinic.data.subscriptionStatus == 'active' &&
        clinic.data.subscriptionPlan in ['starter', 'pro'];
    }

    function canClinicAdminUpdateClinic(clinicId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isClinicAdmin(clinicId) &&
        changed.hasOnly(clinicAdminAllowedClinicFields()) &&
        (
          !changed.hasAny(['theme', 'logoDataUrl']) ||
          clinicAdminCanManageBranding()
        ) &&
        (
          !changed.hasAny(['marketplaceProfile']) ||
          validMarketplaceProfile(request.resource.data.marketplaceProfile)
        ) &&
        (
          !resource.data.keys().hasAny(['marketplaceStatus']) ||
          resource.data.marketplaceStatus != 'verified' ||
          !changed.hasAny([
            'doctorName', 'doctorQualification', 'phone', 'phoneE164',
            'addressLine1', 'addressLine2', 'city', 'googlePlaceId'
          ])
        );
    }

    function superAdminCanUpdateClinic(clinicId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let verificationPath = /databases/$(database)/documents/providerVerifications/$(clinicId);
      return isSuperAdmin() &&
        (
          !changed.hasAny([
            'marketplaceStatus', 'marketplaceSlug', 'marketplaceVerifiedAt',
            'marketplaceVerifiedDoctorIds', 'marketplaceProfile'
          ]) ||
          (
            existsAfter(verificationPath) &&
            getAfter(verificationPath).data.status == request.resource.data.marketplaceStatus &&
            getAfter(verificationPath).data.reviewedBy == request.auth.uid
          )
        );
    }

    function appointmentPath(appointmentId) {
      return /databases/$(database)/documents/appointments/$(appointmentId);
    }

    function canCreateAppointment() {
      return clinicIsActive(request.resource.data.clinicId) &&
        request.resource.data.keys().hasOnly([
          'clinicId', 'lookupKey', 'bookingRef', 'name', 'phone', 'email',
          'service', 'date', 'time', 'doctorId', 'doctorName', 'message',
          'status', 'createdAt', 'updatedAt', 'source', 'phoneE164',
          'patientUid', 'confirmationDeadline', 'attribution',
          'consentVersion', 'consentAt'
        ]) &&
        request.resource.id == request.resource.data.lookupKey &&
        request.resource.data.status == 'pending' &&
        request.resource.data.bookingRef is string &&
        request.resource.data.bookingRef.size() >= 6 &&
        request.resource.data.bookingRef.size() <= 32 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 7 &&
        request.resource.data.phone.size() <= 24 &&
        request.resource.data.phoneE164 is string &&
        request.resource.data.phoneE164.matches('^\\+91[6-9][0-9]{9}$') &&
        (
          request.resource.data.patientUid == null ||
          (
            isPhonePatient() &&
            request.resource.data.patientUid == request.auth.uid &&
            request.resource.data.phoneE164 == request.auth.token.phone_number
          )
        ) &&
        request.resource.data.source in ['clinic_website', 'marketplace'] &&
        request.resource.data.confirmationDeadline is timestamp &&
        (
          request.resource.data.source != 'marketplace' ||
          clinicAcceptsMarketplaceAppointments(request.resource.data.clinicId)
        ) &&
        (
          !request.resource.data.keys().hasAny(['attribution']) ||
          (
            request.resource.data.attribution is map &&
            request.resource.data.attribution.keys().hasOnly(['marketplaceSlug', 'entryPath']) &&
            (!request.resource.data.attribution.keys().hasAny(['marketplaceSlug']) ||
              (request.resource.data.attribution.marketplaceSlug is string &&
                request.resource.data.attribution.marketplaceSlug.size() <= 120)) &&
            (!request.resource.data.attribution.keys().hasAny(['entryPath']) ||
              (request.resource.data.attribution.entryPath is string &&
                request.resource.data.attribution.entryPath.size() <= 240))
          )
        ) &&
        request.resource.data.date is string &&
        request.resource.data.time is string &&
        request.resource.data.lookupKey is string &&
        request.resource.data.lookupKey.size() == 64 &&
        (!request.resource.data.keys().hasAny(['consentVersion']) ||
          (request.resource.data.consentVersion is string &&
            request.resource.data.consentVersion.size() <= 20));
    }

    function hasClinicalOrPaymentData() {
      return resource.data.keys().hasAny([
        'clinicNotes', 'treatmentDone', 'amountCharged',
        'paymentStatus', 'paymentMethod'
      ]);
    }

    function canSelfServeAppointment() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return resource.data.status in ['pending', 'confirmed'] &&
        request.resource.data.clinicId == resource.data.clinicId &&
        request.resource.data.lookupKey == resource.data.lookupKey &&
        request.resource.data.bookingRef == resource.data.bookingRef &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.phone == resource.data.phone &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.doctorId == resource.data.doctorId &&
        request.resource.data.doctorName == resource.data.doctorName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        changed.hasOnly([
          'service', 'date', 'time', 'message', 'status', 'updatedAt',
          'cancellationActor'
        ]) &&
        request.resource.data.status in ['pending', 'cancelled'] &&
        (
          request.resource.data.status != 'cancelled' ||
          request.resource.data.cancellationActor == 'patient'
        );
    }

    function clinicAdminCanUpdateAppointment() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return ownsAppointmentClinic() &&
        changed.hasOnly([
          'status', 'updatedAt', 'cancellationReason', 'cancellationActor',
          'confirmationRespondedAt', 'confirmedAt', 'declinedAt',
          'clinicNotes', 'treatmentDone', 'amountCharged',
          'paymentStatus', 'paymentMethod'
        ]) &&
        (
          !changed.hasAny(['status']) ||
          (
            request.resource.data.status in [
              'confirmed', 'checked_in', 'completed', 'no_show',
              'cancelled', 'declined'
            ] &&
            (
              request.resource.data.status != 'confirmed' ||
              resource.data.status == 'pending'
            ) &&
            (
              request.resource.data.status != 'declined' ||
              (resource.data.status == 'pending' && resource.data.source == 'marketplace')
            ) &&
            (
              !(request.resource.data.status in ['cancelled', 'declined']) ||
              request.resource.data.cancellationActor == 'clinic'
            )
          )
        ) &&
        (
          (
            changed.hasAny(['status']) &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'confirmed' &&
            request.resource.data.confirmedAt == request.time &&
            !changed.hasAny(['declinedAt']) &&
            (
              (
                resource.data.source == 'marketplace' &&
                request.resource.data.confirmationRespondedAt == request.time
              ) ||
              (
                resource.data.source != 'marketplace' &&
                !changed.hasAny(['confirmationRespondedAt'])
              )
            )
          ) ||
          (
            changed.hasAny(['status']) &&
            resource.data.status == 'pending' &&
            resource.data.source == 'marketplace' &&
            request.resource.data.status == 'declined' &&
            request.resource.data.confirmationRespondedAt == request.time &&
            request.resource.data.declinedAt == request.time &&
            !changed.hasAny(['confirmedAt'])
          ) ||
          (
            !changed.hasAny([
              'confirmationRespondedAt', 'confirmedAt', 'declinedAt'
            ]) &&
            !(
              changed.hasAny(['status']) &&
              resource.data.status == 'pending' &&
              request.resource.data.status in ['confirmed', 'declined']
            )
          )
        ) &&
        (
          !changed.hasAny([
            'clinicNotes', 'treatmentDone', 'amountCharged',
            'paymentStatus', 'paymentMethod'
          ]) ||
          clinicHasActiveOperationsPlan(resource.data.clinicId)
        );
    }

    function canCreateSlot() {
      let appointment = getAfter(appointmentPath(request.resource.data.appointmentId));
      return request.resource.data.keys().hasOnly([
        'clinicId', 'doctorId', 'date', 'time', 'appointmentId', 'createdAt', 'updatedAt'
      ]) &&
        appointment.data.clinicId == request.resource.data.clinicId &&
        appointment.data.date == request.resource.data.date &&
        appointment.data.time == request.resource.data.time &&
        appointment.data.doctorId == request.resource.data.doctorId;
    }

    function canDeleteSlot() {
      let appointment = getAfter(appointmentPath(resource.data.appointmentId));
      return appointment.data.status in ['cancelled', 'declined', 'expired'] ||
        appointment.data.date != resource.data.date ||
        appointment.data.time != resource.data.time ||
        appointment.data.doctorId != resource.data.doctorId;
    }

    // ── Clinics ───────────────────────────────────────────────────────────────
    // Public read is intentionally wide: APP_INITIALIZER loads clinic config on
    // every visitor's browser. Sensitive billing/auth fields are stored in the
    // private subcollection below so they are never exposed to patients.
    //
    // Create: super admins only — self-signup goes through the server-side
    //         Admin SDK which bypasses these rules.
    // Update/delete: the clinic's own admin OR a platform super admin.
    match /clinics/{clinicId} {
      allow read:   if true;
      allow create: if isSuperAdmin() && request.resource.data.marketplaceStatus == 'unlisted';
      allow update: if superAdminCanUpdateClinic(clinicId) || canClinicAdminUpdateClinic(clinicId);
      allow delete: if isSuperAdmin();

      // ── Sensitive billing / auth data (never exposed to patients) ─────────
      // Stored separately so `allow read: if true` on the parent doc is safe.
      match /private/{docId} {
        allow read:  if isClinicAdmin(clinicId) || isSuperAdmin();
        allow write: if isSuperAdmin();
      }

      // ── Doctors subcollection ─────────────────────────────────────────────
      match /doctors/{doctorId} {
        allow read:  if true;
        allow write: if isSuperAdmin() ||
          (isClinicAdmin(clinicId) && clinicHasActiveOperationsPlan(clinicId));
      }

      // Usage reservations and signed booking attempts are server-owned.
      match /voiceSessions/{sessionId} {
        allow read, write: if false;
      }
    }

    // ── Appointments ──────────────────────────────────────────────────────────
    // create/read: unauthenticated — patients book and look up by ref+phone.
    //
    // update: the clinic admin who OWNS this appointment's clinic, OR a super
    //         admin. Any other authenticated user (e.g. a different clinic's
    //         doctor) is explicitly denied.
    //
    // delete: super admin only — clinic admins cancel via status update, not
    //         hard delete, so patient records are preserved.
    match /appointments/{appointmentId} {
      allow create: if canCreateAppointment();
      allow get:    if ownsAppointmentClinic() || isSuperAdmin() || !hasClinicalOrPaymentData();
      allow list:   if ownsAppointmentClinic() || isSuperAdmin();
      allow update: if clinicAdminCanUpdateAppointment() || isSuperAdmin() || canSelfServeAppointment();
      allow delete: if isSuperAdmin();
    }

    // ── Patient portal profiles ─────────────────────────────────────────────
    // Created and updated only by the authenticated patient API. Patients can
    // read their own minimal profile; appointment history remains API-only so
    // clinical and billing fields can never leak through full Firestore docs.
    match /patients/{uid} {
      allow get: if isSuperAdmin() ||
        (
          isPhonePatient() &&
          request.auth.uid == uid &&
          resource.data.phoneE164 == request.auth.token.phone_number
        );
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── Appointment-verified reviews ──────────────────────────────────────
    // Trusted server code creates reviews after checking completed appointment
    // ownership. Public documents contain no patient UID or appointment ID.
    match /appointmentReviews/{reviewId} {
      allow read: if resource.data.moderationStatus == 'published' || isSuperAdmin();
      allow create, delete: if false;
      allow update: if
        (
          isSuperAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'moderationStatus', 'publishedAt', 'updatedAt'
          ]) &&
          request.resource.data.moderationStatus in ['published', 'rejected'] &&
          request.resource.data.updatedAt == request.time &&
          (
            (request.resource.data.moderationStatus == 'published' &&
              request.resource.data.publishedAt == request.time) ||
            (request.resource.data.moderationStatus == 'rejected' &&
              request.resource.data.publishedAt == null)
          ) &&
          getAfter(/databases/$(database)/documents/appointmentReviewModeration/$(reviewId)).data.status ==
            request.resource.data.moderationStatus &&
          getAfter(/databases/$(database)/documents/appointmentReviewModeration/$(reviewId)).data.reviewedBy ==
            request.auth.uid
        ) ||
        (
          isClinicAdmin(resource.data.clinicId) &&
          resource.data.moderationStatus == 'published' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'clinicResponse', 'clinicRespondedAt', 'updatedAt'
          ]) &&
          request.resource.data.clinicResponse is string &&
          request.resource.data.clinicResponse.size() >= 2 &&
          request.resource.data.clinicResponse.size() <= 600 &&
          request.resource.data.clinicRespondedAt == request.time &&
          request.resource.data.updatedAt == request.time
        );
    }

    // Appointment linkage and reviewer ownership remain platform-private.
    match /appointmentReviewModeration/{reviewId} {
      allow read: if isSuperAdmin();
      allow create, delete: if false;
      allow update: if isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ]) &&
        request.resource.data.status in ['published', 'rejected'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/appointmentReviews/$(reviewId)).data.moderationStatus ==
          request.resource.data.status;
    }

    // Reports are submitted through the authenticated patient API. Reporter
    // identity is never readable by clinics or public marketplace visitors.
    match /appointmentReviewReports/{reportId} {
      allow read: if isSuperAdmin();
      allow create, delete: if false;
      allow update: if isSuperAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ]) &&
        request.resource.data.status in ['resolved', 'dismissed'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    // ── Contacts ─────────────────────────────────────────────────────────────
    // Public create: submitted via the unauthenticated contact form on clinic
    // sites and the platform landing page. Sensitive data (read/edit/delete)
    // is restricted to super admins only.
    match /contacts/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'clinicId', 'name', 'phone', 'email', 'message', 'consentVersion',
          'consentAt', 'createdAt'
        ]) &&
        clinicIsActive(request.resource.data.clinicId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 7 &&
        request.resource.data.phone.size() <= 24 &&
        (request.resource.data.email == null ||
          (request.resource.data.email is string && request.resource.data.email.size() <= 160)) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 2 &&
        request.resource.data.message.size() <= 2000 &&
        (!request.resource.data.keys().hasAny(['consentVersion']) ||
          (request.resource.data.consentVersion is string &&
            request.resource.data.consentVersion.size() <= 20));
      allow read, update, delete: if isSuperAdmin();
    }

    // ── Leads ─────────────────────────────────────────────────────────────────
    // Platform CRM — super admin only. Clinic admins must NOT be able to read
    // the platform's prospect pipeline.
    match /leads/{leadId} {
      allow read, write: if isSuperAdmin();

      match /activities/{activityId} {
        allow read, write: if isSuperAdmin();
      }
    }

    // ── Marketplace provider verification ──────────────────────────────────
    // Registration evidence and review notes never live on public clinic docs.
    // Listing state, slugs, evidence, and audit records are platform-owned.
    match /providerVerifications/{clinicId} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin() &&
        request.resource.data.clinicId == clinicId &&
        validMarketplaceStatus(request.resource.data.status) &&
        request.resource.data.reviewedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/clinics/$(clinicId)).data.marketplaceStatus ==
          request.resource.data.status;
      allow delete: if false;
    }

    match /providerVerificationEvents/{eventId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        request.resource.data.clinicId is string &&
        validMarketplaceStatus(request.resource.data.status) &&
        request.resource.data.reviewerUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)).data.marketplaceStatus ==
          request.resource.data.status;
      allow update, delete: if false;
    }

    match /marketplaceSlugs/{slug} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin() &&
        request.resource.data.clinicId is string &&
        getAfter(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)).data.marketplaceSlug == slug;
      allow delete: if isSuperAdmin() &&
        (
          !getAfter(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.keys().hasAny(['marketplaceSlug']) ||
          getAfter(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.marketplaceSlug != slug
        );
    }

    // ── Super Admins ──────────────────────────────────────────────────────────
    match /superAdmins/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Analytics / counters ──────────────────────────────────────────────────
    // Read/write: super admin only (shown on Revenue / Analytics pages).
    match /analytics/{docId} {
      allow read:  if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── Platform settings ─────────────────────────────────────────────────────
    match /platform/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Notification queue (trial expiry emails, reminders) ───────────────────
    // Written server-side via Admin SDK; client never reads or writes directly.
    match /notifications/{docId} {
      allow read, write: if false;
    }

    // ── Server-side abuse controls ──────────────────────────────────────────
    // Rate-limit buckets are written only by trusted server functions using
    // the Admin SDK. Browsers must never be able to inspect or alter them.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // ── Slots (atomic slot reservations for double-booking prevention) ────────
    // Written atomically by the booking transaction. Readable publicly (booking
    // form needs to check availability). Only the owning clinic admin can delete.
    match /slots/{slotId} {
      allow read:   if true;
      allow create: if canCreateSlot();
      allow delete: if canDeleteSlot() || isClinicAdmin(resource.data.clinicId);
      allow update: if false;
    }
  }
}
